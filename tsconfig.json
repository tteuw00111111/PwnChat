{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": false,
    "strict": true,
    "noEmit": true, // 👈 só checa tipos, não gera arquivos
    "skipLibCheck": true,
    "types": ["node", "electron"]
  },
  "include": ["src", "electron", "vite.config.ts", "vite-env.d.ts"],
  "exclude": ["dist", "dist-electron", "node_modules"]
}
