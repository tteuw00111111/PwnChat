{
  "name": "pwnchat-project",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "rm -rf devtool-logs/* || true && npm run build:native && npm run build:electron && concurrently -k \"npm:dev:renderer\" \"npm:build:electron:watch\" \"npm:start:electron\"",
    "dev:renderer": "vite",
    "start:electron": "electron .",
    "build": "npm run build:native && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "rm -rf devtool-logs/* || true && npm run build:main && npm run build:preload",
    "build:native": "cd native/signal && node-gyp configure build",
    "test:native": "npm run build:native && node native/signal/tests/headless.mjs",
    "build:main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --external:argon2 --external:better-sqlite3 --external:sqlite3 --outfile=dist-electron/main.cjs",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist-electron/preload.cjs",
    "build:electron:watch": "concurrently -k \"npm:build:main:watch\" \"npm:build:preload:watch\"",
    "build:main:watch": "esbuild electron/main.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --external:argon2 --external:better-sqlite3 --external:sqlite3 --outfile=dist-electron/main.cjs --watch",
    "build:preload:watch": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist-electron/preload.cjs --watch",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder --win --mac --linux",
    "dist:dir": "npm run build && electron-builder --dir",
    "release": "npm run build && electron-builder --publish=always",
    "release:draft": "npm run build && electron-builder --publish=onTagOrDraft",
    "postinstall": "electron-builder install-app-deps",
    "build:icons": "node build/icon-generator.js",
    "version:major": "node scripts/version-bump.js major",
    "version:minor": "node scripts/version-bump.js minor",
    "version:patch": "node scripts/version-bump.js patch",
    "version:prerelease": "node scripts/version-bump.js prerelease"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.21",
    "bindings": "^1.5.0",
    "concurrently": "^9.2.1",
    "electron": "^30.5.1",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.21.5",
    "node-addon-api": "^7.1.1",
    "node-gyp": "^10.2.0",
    "postcss": "^8.5.6",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@geist-ui/core": "^2.3.8",
    "@geist-ui/icons": "^1.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "argon2": "^0.44.0",
    "axios": "^1.11.0",
    "better-sqlite3": "^12.2.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.471.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.1",
    "socket.io-client": "^4.8.1",
    "sqlite3": "^5.1.7"
  }
}
