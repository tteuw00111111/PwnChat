// tsconfig.node.json

{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022", // 👈 THE FINAL FIX
    "module": "CommonJS", // 👈 THE FIX
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "jsx": "react-jsx",

    /* Node types para processos de build/electron */
    "types": ["node"]
  },
  "include": [
    "src",
    "electron",
    "vite.config.ts",
    "vite-env.d.ts",
    "electron-builder.json5"
  ]
}
